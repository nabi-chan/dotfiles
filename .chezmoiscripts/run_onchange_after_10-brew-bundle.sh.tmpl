#!/bin/bash
# Brewfile hash: {{ include "dot_homebrew/Brewfile" | sha256sum }}
set -euo pipefail

if [ ! -x /opt/homebrew/bin/brew ]; then
  echo "Homebrew 가 없어서 먼저 설치함" >&2
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

brew bundle install --no-upgrade --file="$HOME/.homebrew/Brewfile"
