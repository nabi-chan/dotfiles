#!/bin/bash
# Brewfile hash: {{ include "dot_homebrew/Brewfile" | sha256sum }}
set -euo pipefail

if [ ! -x /opt/homebrew/bin/brew ]; then
  echo "Homebrew 가 없어서 중단함. https://brew.sh 로 설치한 뒤 다시 chezmoi apply" >&2
  exit 1
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

brew bundle install --no-upgrade --file="$HOME/.homebrew/Brewfile"
