{{- /* chezmoi:modify-template */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $servers := dict -}}
{{- range $name, $server := includeTemplate "mcp-servers.json" . | fromJson -}}
{{-   $_ := set $servers $name (merge (dict "type" "stdio" "env" dict) $server) -}}
{{- end -}}
{{- $config = setValueAtPath "mcpServers" $servers $config -}}
{{ toPrettyJson $config }}
